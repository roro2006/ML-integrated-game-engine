// Models: low-poly recipes of parametric shapes (ADR-0017).
//
// Every part is a shape from the approved set — Box, Wedge, Cylinder, Cone,
// Frustum, Sphere, Taper, Dome — hung from a slot of its body plan and painted
// from its palette. Lengths are milli-metres; `at` is measured from the slot's
// pivot; `turn` is milli-degrees about X, then Y, then Z; `stretch` scales the
// shape per axis before it is turned (1000 is unstretched). `top` and `bottom`
// repaint faces within about 45 degrees of straight up or down.
//
// The silhouette language is Old School RuneScape's: trapezoid torsos wide at
// the chest and narrow at the waist, limbs that taper to wrist and ankle,
// flared boots and skirts, domed pauldrons and helmets, jagged hems, spikes.
// Tapers and domes carry most of it; stretch turns a sphere into a head and a
// dome into a shoulder plate.
//
// No vertex data appears anywhere, which is what lets validation bound a model
// and an AI propose one (ADR-0010). Budgets: 24 parts, 1500 triangles.
[
    // The player: warm tunic under a leather harness, a cloak with a ragged
    // hem, and a tapered blade carried in the right hand so it swings with
    // the arm.
    (
        schema_version: 1,
        id: "wayfinder",
        name: "Wayfinder",
        body_plan: "humanoid",
        palette: "cinderwake",
        parts: [
            (slot: "torso", shape: Taper(x: 360, z: 230, top_x: 520, top_z: 300, height: 540), at: (x: 0, y: 290, z: 0), color: "tunic"),
            (slot: "torso", shape: Taper(x: 370, z: 240, top_x: 360, top_z: 235, height: 80), at: (x: 0, y: 20, z: 0), color: "leather"),
            (slot: "torso", shape: Taper(x: 440, z: 300, top_x: 370, top_z: 245, height: 260), at: (x: 0, y: -150, z: 0), color: "cloak"),
            (slot: "torso", shape: Frustum(bottom: 190, top: 150, height: 80, sides: 6), at: (x: 0, y: 590, z: 0), color: "cloak"),
            (slot: "torso", shape: Taper(x: 460, z: 50, top_x: 420, top_z: 40, height: 820), at: (x: 0, y: 170, z: 190), turn: (x: 6000, y: 0, z: 0), color: "cloak"),
            (slot: "torso", shape: Taper(x: 140, z: 40, top_x: 0, top_z: 0, height: 130), at: (x: -120, y: -270, z: 205), turn: (x: 180000, y: 0, z: 0), color: "cloak"),
            (slot: "torso", shape: Taper(x: 140, z: 40, top_x: 0, top_z: 0, height: 130), at: (x: 120, y: -270, z: 205), turn: (x: 180000, y: 0, z: 0), color: "cloak"),
            (slot: "head", shape: Taper(x: 230, z: 240, top_x: 250, top_z: 250, height: 270), at: (x: 0, y: 190, z: 0), color: "skin"),
            (slot: "head", shape: Dome(radius: 150, segments: 8, rings: 2), at: (x: 0, y: 350, z: 10), stretch: (x: 1000, y: 700, z: 1050), color: "hair"),
            (slot: "head", shape: Taper(x: 250, z: 90, top_x: 260, top_z: 80, height: 220), at: (x: 0, y: 210, z: 120), color: "hair"),
            (slot: "head", shape: Wedge(x: 50, y: 70, z: 60), at: (x: 0, y: 170, z: -150), color: "skin-dark"),
            (slot: "arm-l", shape: Dome(radius: 150, segments: 6, rings: 2), at: (x: 0, y: 10, z: 0), stretch: (x: 1100, y: 800, z: 1000), color: "leather"),
            (slot: "arm-l", shape: Taper(x: 110, z: 110, top_x: 150, top_z: 150, height: 440), at: (x: 0, y: -220, z: 0), color: "tunic"),
            (slot: "arm-l", shape: Box(x: 110, y: 130, z: 120), at: (x: 0, y: -500, z: 0), color: "skin"),
